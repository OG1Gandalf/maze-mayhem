{
  "name": "maze-mayhem",
  "version": "1.0.0",
  "description": "Two-player online maze race with combat, coins and corrupt NPCs.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --include ./shared server/dev.ts",
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --target=node20 --outfile=dist/server/index.js",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "express": "^5.3.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
